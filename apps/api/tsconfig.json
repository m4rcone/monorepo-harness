{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A API roda no Node (tsc → node dist/): imports relativos com extensão ".js"
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  // O pacote inteiro (scripts/ etc.): o ESLint com type info falha em .ts fora de um `include`
  "include": ["**/*"],
  "exclude": ["dist"]
}
