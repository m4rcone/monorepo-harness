{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // ADAPTE ao framework: ex. Vite → "types": ["vite/client"]; JSX → "jsx": "react-jsx"
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  // O pacote inteiro (scripts/ etc.): o ESLint com type info falha em .ts fora de um `include`
  "include": ["**/*"],
  "exclude": ["dist"]
}
